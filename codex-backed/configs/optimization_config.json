    "short_term_trailing_atr_multiplier": [2.0, 2.5, 3.0],
    "medium_term_initial_atr_multiplier": [2.0, 2.5, 3.0],
    "medium_term_target_r_multiple": [2.0, 2.5, 3.0],
    "medium_term_partial_sell_pct": [33, 40, 50],
    "medium_term_trailing_atr_multiplier": [2.5, 3.0, 3.5]
  }
}

